{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "src/ids.ts",
        "src/time.ts",
        "src/states.ts",
        "tests/architecture/fixtures/type-fixtures.ts"
    ]
}
