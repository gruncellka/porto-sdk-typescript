# Porto SDK TypeScript - Environment Variables
# Copy this file to .env and fill in your credentials
# .env is gitignored for security
#
# IMPORTANT: Use Portokasse username/password, NOT DHL Developer Portal API keys

# Internetmarke API Credentials (OPTIONAL - only needed for stamp generation)
# If provided: can generate stamps via API
# If not provided: validation/pricing still work (use porto-data), but stamp generation unavailable
INTERNETMARKE_USERNAME=your-portokasse-username
INTERNETMARKE_PASSWORD=your-portokasse-password

# Internetmarke API Base URL (only used if credentials provided)
INTERNETMARKE_BASE_URL=https://internetmarke.deutschepost.de
# Or use staging URL:
# INTERNETMARKE_BASE_URL=https://internetmarke-staging.deutschepost.de
